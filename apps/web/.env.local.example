# Trifecta Platform — apps/web environment (copy to .env.local; .env.local is gitignored)

# Phase 0 — Signal chat
ANTHROPIC_API_KEY=
MCP_SERVER_URL=

# Phase 1 · M1 — Supabase (Auth + Postgres)
# From Supabase dashboard → Project Settings → API keys.
NEXT_PUBLIC_SUPABASE_URL=
# New key scheme: the publishable key (sb_publishable_…). Browser-safe.
# (Legacy NEXT_PUBLIC_SUPABASE_ANON_KEY is still accepted as a fallback.)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…) BYPASSES row-level security — server-side only (provisioning).
# Never expose to the browser; never prefix with NEXT_PUBLIC_.
# (Legacy SUPABASE_SERVICE_ROLE_KEY is still accepted as a fallback.)
SUPABASE_SECRET_KEY=
