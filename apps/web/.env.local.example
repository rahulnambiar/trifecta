# Trifecta Platform — apps/web environment (copy to .env.local; .env.local is gitignored)

# Phase 0 — Signal chat
ANTHROPIC_API_KEY=
MCP_SERVER_URL=

# Phase 1 · M1 — Supabase (Auth + Postgres)
# From Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key BYPASSES row-level security — server-side only (provisioning).
# Never expose to the browser; never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
